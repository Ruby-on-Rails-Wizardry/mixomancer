#!/bin/bash
# Full-screen Mixomancer on the HDMI output. No login session required.
set -euo pipefail

DEFAULT_URL="${MIXOMANCER_KIOSK_URL:-http://127.0.0.1/display}"
STATE_DIR="${MIXOMANCER_STATE_DIR:-/var/lib/mixomancer}"
STATE_FILE="$STATE_DIR/kiosk-url"
HEALTH="${MIXOMANCER_HEALTH_URL:-http://127.0.0.1/up}"
URL="$DEFAULT_URL"
if [[ -f "$STATE_FILE" ]]; then
  IFS= read -r URL < "$STATE_FILE" || URL="$DEFAULT_URL"
fi
# Only an http(s) address overrides the display. Anything else falls back.
if [[ ! "$URL" =~ ^https?://[^[:space:]]+$ ]]; then
  URL="$DEFAULT_URL"
fi
# Bust Chromium's disk cache for the now-playing page. Leave other URLs alone.
if [[ "${URL%%\?*}" == "${DEFAULT_URL%%\?*}" ]]; then
  URL="${DEFAULT_URL%%\?*}?v=$(date +%s)"
fi
PROFILE="${MIXOMANCER_KIOSK_PROFILE:-/home/haruna/.config/mixomancer-kiosk}"
mkdir -p "$PROFILE"

for _ in $(seq 1 60); do
  if curl -sf -o /dev/null --max-time 1 "$HEALTH"; then
    break
  fi
  sleep 1
done

exec /usr/bin/cage -s -- /usr/bin/chromium \
  --ozone-platform=wayland \
  --enable-features=UseOzonePlatform \
  --user-data-dir="$PROFILE" \
  --kiosk \
  --no-first-run \
  --noerrdialogs \
  --disable-infobars \
  --disable-session-crashed-bubble \
  --disable-translate \
  --disable-features=TranslateUI \
  --disable-http-cache \
  --disk-cache-size=1 \
  --check-for-update-interval=31536000 \
  --autoplay-policy=no-user-gesture-required \
  --start-fullscreen \
  --window-size=1920,1080 \
  "$URL"
