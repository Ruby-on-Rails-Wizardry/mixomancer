[Unit]
Description=Mixomancer HDMI kiosk (Chromium on cage, no console login)
After=systemd-udev-settle.service network-online.target
Wants=systemd-udev-settle.service network-online.target
Conflicts=mixomancer-display.service mixomancer-video.service
ConditionPathExists=/usr/bin/cage
ConditionPathExists=/usr/bin/chromium

[Service]
Type=simple
User=rob
Group=rob
SupplementaryGroups=video seat
WorkingDirectory=/home/rob/Ruby-on-Rails-Wizardry/mixomancer
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=XDG_SESSION_TYPE=wayland
Environment=WLR_LIBINPUT_NO_DEVICES=1
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYPath=/dev/tty7
TTYReset=yes
TTYVHangup=yes
ExecStartPre=+/usr/bin/chvt 7
ExecStart=/home/rob/Ruby-on-Rails-Wizardry/mixomancer/bin/kiosk
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
