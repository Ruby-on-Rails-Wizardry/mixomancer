[Unit]
Description=Mixomancer Rails development server
After=network-online.target pipewire-pulse.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/rob/Ruby-on-Rails-Wizardry/mixomancer
Environment=PATH=/home/rob/.local/share/mise/shims:/home/rob/.local/share/mise/installs/ruby/4.0.6/bin:/usr/bin:/usr/local/bin
Environment=RAILS_ENV=development
Environment=PORT=3000
Environment=BINDING=0.0.0.0
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStart=/home/rob/Ruby-on-Rails-Wizardry/mixomancer/bin/rails server -b 0.0.0.0 -p 3000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
