[Unit]
Description=Mixomancer HDMI video
After=systemd-udev-settle.service
Conflicts=mixomancer-kiosk.service mixomancer-display.service
OnSuccess=mixomancer-kiosk.service

[Service]
Type=simple
User=haruna
Group=haruna
SupplementaryGroups=video audio render
Environment=XDG_RUNTIME_DIR=/run/user/2003
Environment=PULSE_SERVER=unix:/run/user/2003/pulse/native
Environment=MIXOMANCER_STATE_DIR=/var/lib/mixomancer
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYPath=/dev/tty7
TTYReset=yes
TTYVHangup=yes
ExecStartPre=+/usr/bin/chvt 7
ExecStart=/opt/mixomancer/bin/play-video
Restart=no
