[Unit]
Description=Mixomancer HDMI splash (no console login)
Documentation=file:///home/rob/Ruby-on-Rails-Wizardry/mixomancer/systemd/mixomancer-display.service
After=systemd-udev-settle.service
Wants=systemd-udev-settle.service
ConditionPathExists=/home/rob/Ruby-on-Rails-Wizardry/mixomancer/public/display.png

[Service]
Type=simple
User=rob
Group=rob
SupplementaryGroups=video
WorkingDirectory=/home/rob/Ruby-on-Rails-Wizardry/mixomancer
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYPath=/dev/tty7
TTYReset=yes
TTYVHangup=yes
ExecStartPre=+/usr/bin/chvt 7
ExecStart=/usr/bin/mpv --ao=null --vo=gpu --gpu-context=drm --drm-connector=HDMI-A-2 --drm-mode=1920x1080 --image-display-duration=inf --loop-file=inf --osd-level=0 --no-input-default-bindings --no-input-terminal --no-audio public/display.png
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
