<% content_for :title, "Remotes · Mixomancer" %>

<div class="mx-auto w-full max-w-3xl space-y-6">
  <header>
    <h1 class="text-3xl font-bold tracking-tight text-zinc-50">Remotes</h1>
  </header>

  <ul class="grid gap-4 sm:grid-cols-2">
    <% @remotes.each do |remote| %>
      <li>
        <%= link_to remote_path(remote.id), class: "block rounded-xl border border-zinc-800 bg-zinc-900/60 p-5 hover:border-violet-500/60" do %>
          <p class="text-lg font-semibold text-zinc-50"><%= remote.name %></p>
          <p class="mt-1 text-sm text-zinc-400"><%= remote.protocol.upcase %> · <%= remote.buttons.size %> keys</p>
        <% end %>
      </li>
    <% end %>
  </ul>
</div>
