<% content_for :title, "Mixomancer" %>
<% artwork = Artwork.url_for(title: @now_playing[:title], album: @now_playing[:album]) %>

<div class="player-shell w-full space-y-8"
     data-controller="player"
     data-player-url-value="<%= now_playing_path %>"
     data-player-seek-url-value="<%= seek_path %>"
     data-player-replay-url-value="<%= replay_path %>"
     data-player-forward-url-value="<%= forward_path %>">
  <div data-player-target="backdrop"
       class="display-backdrop<%= " is-on" if artwork %>"
       <% if artwork %>style="background-image: url('<%= artwork %>')"<% end %>></div>
  <section class="rounded-xl border border-zinc-800 bg-zinc-900/60 p-5">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <h1 class="text-sm font-semibold uppercase tracking-wide text-zinc-400">Now playing</h1>
        <p class="mt-2 <%= "hidden" if @now_playing[:state] == "playing" %>">
          <span data-player-target="badge" class="<%= player_state_badge_class(@now_playing[:state]) %>"><%= @now_playing[:state] %></span>
        </p>
      </div>
      <div class="flex gap-3">
        <%= button_to play_path, method: :post,
              form_class: "inline",
              class: transport_play_class,
              disabled: @now_playing[:state] == "playing",
              data: { player_target: "play" } do %>
          <%= media_icon(:play) %>
          Play
        <% end %>
        <%= button_to stop_path, method: :post,
              form_class: "inline",
              class: transport_pause_class,
              disabled: @now_playing[:state] != "playing",
              data: { player_target: "pause" } do %>
          <%= media_icon(:pause) %>
          Pause
        <% end %>
      </div>
    </div>

    <p data-player-target="title" class="mt-4 text-2xl font-semibold text-zinc-50"><%= player_title(@now_playing) %></p>
    <p data-player-target="album" class="mt-1 text-sm text-zinc-400"><%= @now_playing[:album] %></p>

    <div data-player-target="meta" class="mt-4 <%= "hidden" if @now_playing[:state] == "stopped" %>">
      <div class="mb-2 flex items-center justify-between gap-3">
        <button type="button" data-action="player#replay"
                class="rounded-md border border-zinc-600 bg-zinc-800 px-3 py-1 text-xs font-semibold text-zinc-100 hover:bg-zinc-700">
          Replay 30s
        </button>
        <button type="button" data-action="player#forward"
                class="rounded-md border border-zinc-600 bg-zinc-800 px-3 py-1 text-xs font-semibold text-zinc-100 hover:bg-zinc-700">
          Forward 30s
        </button>
      </div>
      <p class="mb-2 font-mono text-sm text-zinc-400">
        <span data-player-target="position"><%= @now_playing[:position_label] %></span>
        /
        <span data-player-target="duration"><%= @now_playing[:duration_label] %></span>
        <span data-player-target="index" class="ml-3">
          <% if @now_playing[:playlist_pos] && @now_playing[:playlist_count] %>
            <%= @now_playing[:playlist_pos] %> of <%= @now_playing[:playlist_count] %>
          <% end %>
        </span>
      </p>
      <div data-player-target="bar"
           data-action="pointerdown->player#startSeek pointermove->player#moveSeek pointerup->player#endSeek pointercancel->player#endSeek"
           class="relative h-8 w-full cursor-pointer touch-none">
        <div class="absolute inset-x-0 top-1/2 h-2 -translate-y-1/2 overflow-hidden rounded-full bg-zinc-800">
          <div data-player-target="progress" class="h-2 rounded-full bg-violet-500" style="width: <%= @now_playing[:percent] %>%"></div>
        </div>
      </div>
    </div>
  </section>
</div>
